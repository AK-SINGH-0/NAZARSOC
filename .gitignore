# NazarSOC — .gitignore

# -- Virtual environment
venv/
.venv/
env/
ENV/

# -- SQLite database files
*.db
*.db-wal
*.db-shm

# -- Python cache
__pycache__/
*.py[cod]
*.pyo

# -- Secrets and credentials
.env
*.key
*.pem
secrets.json
secrets.yaml
secrets.yml

# -- OS / editor artefacts
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/

# -- Build / distribution
dist/
build/
*.egg-info/
*.egg
*.whl

# -- Test / coverage artefacts
.coverage
htmlcov/
.pytest_cache/
*.xml

# -- Explicitly keep source and demo data
# (engine.py, database.py, reporting.py, app.py, test_project.py,
#  demo_events.json, requirements.txt, README.md, PROJECT_REPORT.md,
#  run.bat are tracked by git)
